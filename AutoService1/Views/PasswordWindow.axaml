<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:views="clr-namespace:AutoService1.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AutoService1.Views.PasswordWindow"
        x:DataType="views:PasswordWindowViewModel"
        Title="PasswordWindow">
    <StackPanel>
        <TextBox Text="{Binding Password}"/>
        <Button Content="Поддтвердить" Command="{Binding StartCommand}"/>
        <Button Content="Выйти" Command="{Binding CloseCommand}"/>
    </StackPanel>
</Window>
